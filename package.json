{
  "name": "perler-beads-studio",
  "version": "0.1.0",
  "description": "Desktop studio for converting images into editable Perler bead patterns.",
  "main": "./out/main/index.js",
  "author": "Perler Beads Studio",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "package:win": "npm run build && electron-builder --win portable --x64"
  },
  "dependencies": {
    "@iconify/vue": "^5.0.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "autoprefixer": "^10.4.20",
    "electron": "^35.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^3.0.0",
    "postcss": "^8.5.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.0",
    "vite": "^6.2.0",
    "vue-tsc": "^2.2.0"
  },
  "build": {
    "appId": "com.perlerbeads.studio",
    "productName": "Perler Beads Studio",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-win-${arch}.${ext}",
      "signAndEditExecutable": false
    },
    "asar": true,
    "npmRebuild": false,
    "electronDist": "node_modules/electron/dist",
    "electronVersion": "35.7.5"
  }
}
